@model CartDto
@{ ViewData["Title"] = "Корзина"; }

<h1>Корзина</h1>
@if (Model.Lines.Count == 0)
{
    <p>Корзина пуста. <a asp-controller="Catalog" asp-action="Index">В каталог</a></p>
}
else
{
    <table class="cart-table">
        <thead>
            <tr><th>Товар</th><th>Цена</th><th>Кол-во</th><th>Сумма</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var l in Model.Lines)
        {
            <tr>
                <td>@l.Name</td>
                <td>@l.Price.ToString("C")</td>
                <td>@l.Quantity</td>
                <td>@l.LineTotal.ToString("C")</td>
                <td>
                    <form asp-action="Remove" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@l.Id" />
                        <button type="submit" class="link">Удалить</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>

    <p class="total">Итого: <strong>@Model.Total.ToString("C")</strong></p>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <form asp-controller="Orders" asp-action="Checkout" method="post" class="inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn">Оформить заказ</button>
        </form>
    }
    else
    {
        <a class="btn" asp-controller="Account" asp-action="Login">Войти для оформления</a>
    }
}