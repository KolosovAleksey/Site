<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Store</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @Html.AntiForgeryToken()

    <header class="topbar">
        <a asp-controller="Home" asp-action="Index" class="logo">🛒 Магазин</a>
        <a asp-controller="Catalog" asp-action="Index">Каталог</a>
        <a asp-controller="Cart" asp-action="Index">Корзина (<span id="cartBadge">0</span>)</a>
        <span class="spacer"></span>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <span>@User.Identity.Name</span>
            <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                @Html.AntiForgeryToken()
                <button type="submit">Выйти</button>
            </form>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login">Вход</a>
            <a asp-controller="Account" asp-action="Register">Регистрация</a>
        }
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <aside id="cartSummary" class="cart-aside"></aside>

    <script src="~/js/cart.js" asp-append-version="true"></script>
</body>
</html>